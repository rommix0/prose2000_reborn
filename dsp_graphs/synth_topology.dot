digraph prose_dsp {
  graph [rankdir=TB, newrank=true, nodesep=0.3, ranksep=0.38, fontname="Helvetica", fontsize=12, labelloc=t, pad=0.3, label=<<B>Prose 2000 DSP (µPD7720, program v3.12): synthesizer topology, one sample every 100 µs (10 kHz)</B><BR/><FONT POINT-SIZE="10">Decompiled program: src/dsp/prose_synth.c (REFERENCE §13). [xxx] = program address. wN = word N of the 40-word frame the 8086 sends every 10 ms (§11.3). Resonator values are pole frequency / bandwidth.</FONT>>];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=11, color="#555555", margin="0.08,0.04"];
  edge [fontname="Helvetica", fontsize=9, color="#333333", arrowsize=0.7];
  subgraph cluster_ctl { label=<<B>Control</B>>; style="rounded,dashed"; color="#9a3fb8"; fontcolor="#9a3fb8";
  fetch [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Frame fetch</B>  <FONT POINT-SIZE="9" COLOR="#666666">[1A2]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">every 100 samples (RAM[3C] runs out)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">raise USF0, pulse P0 → 8086 IRQ (8259 IR0)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w0: closing type (bits 0-4), silence (bit 7),</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">     output offset ROM[0x145+n] (bits 8-12)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w1: phase step = w1·0x517D &gt;&gt; 15</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w2-w39 → RAM[ROM[0x145−i] &gt;&gt; 3]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">no word: keep the frame once, then silence</FONT></TD></TR></TABLE>>, fillcolor="#cfe3fa"];
  pitch [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Pitch clock</B>  <FONT POINT-SIZE="9" COLOR="#666666">[15C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">counts the period down (RAM[3E])</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">and the half period (RAM[3F])</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">periods w30 / w31 alternate (jitter)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">unvoiced (period 0): restarts every sample</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  }
  subgraph cluster_src { label=<<B>Sources</B>>; style=rounded; color="#888888";
  pulse [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Glottal pulse</B>  <FONT POINT-SIZE="9" COLOR="#666666">[147]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">phase accumulator RAM[2E] += step</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">shape: ROM[2 + phase_hi] − frac·slope</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">opening: AV/2 − (AV/2)·shape</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">closing (after wrap): AV·(1 − rate·(1 − shape)),</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">     rate = ROM[0x103 + type], fine ramp if type ≥ 15</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">then 0 until the next period</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">AV = w34 / w35, alternating (shimmer)</FONT></TD></TR></TABLE>>, fillcolor="#cfe3fa"];
  gdiff [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>First difference, ×8</B>  <FONT POINT-SIZE="9" COLOR="#666666">[064]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">saturating (radiation / flow derivative)</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  xw17 [label=<× w17<BR/><FONT POINT-SIZE="8">voice gain<BR/>V0 17368, V1 20000, V2 16384</FONT>>, shape=box, style="rounded,filled", fontsize=10, fillcolor="#cdeccb", margin="0.06,0.03"];
  noise [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Noise generator</B>  <FONT POINT-SIZE="9" COLOR="#666666">[07A]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">k = RAM[2A] ^ RAM[3A]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">new = ((k &gt;&gt; 7) &amp; 0x1F8) | (k &lt;&lt; 6)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">0 → 0xAAAA (seed, setup word 2)</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  xah [label=<× AH<BR/><FONT POINT-SIZE="8">w16</FONT>>, shape=box, style="rounded,filled", fontsize=10, fillcolor="#cfe3fa", margin="0.06,0.03"];
  ssrc [label="Σ", shape=circle, fixedsize=true, width=0.42, fontsize=15, fillcolor="#ffffff"];
  }
  glot [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Glottal filter</B>  <FONT POINT-SIZE="9" COLOR="#666666">[128]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">resonator, gain w37, coefficients w38 / w39</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">V0 flat (no poles)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">V1 1500 Hz / 2000 Hz</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">V2 2500 Hz / 2000 Hz</FONT></TD></TR></TABLE>>, fillcolor="#cdeccb"];
  subgraph cluster_casc { label=<<B>Cascade branch</B> (voicing + aspiration)>; style=rounded; color="#2f6db5"; fontcolor="#2f6db5";
  c5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>R5 (F5)</B>  <FONT POINT-SIZE="9" COLOR="#666666">[11C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w4 / w5, fixed per voice</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">V0 3970 Hz / 200 Hz</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">V1 3700 Hz / 500 Hz</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">V2 4400 Hz / 500 Hz</FONT></TD></TR></TABLE>>, fillcolor="#cdeccb"];
  c4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>R4 (F4)</B>  <FONT POINT-SIZE="9" COLOR="#666666">[11C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w6 = F4 (p12)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w7 fixed: bandwidth 210 Hz</FONT></TD></TR></TABLE>>, fillcolor="#cfe3fa"];
  c3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>R3 (F3)</B>  <FONT POINT-SIZE="9" COLOR="#666666">[11C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w8 / w9 = F3, B3 (p11, p15)</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  c2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>R2 (F2)</B>  <FONT POINT-SIZE="9" COLOR="#666666">[11C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w10 / w11 = F2, B2 (p10, p14)</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  cnp [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Nasal pole</B>  <FONT POINT-SIZE="9" COLOR="#666666">[11C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w12 / w13, fixed</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">253 Hz / 103 Hz</FONT></TD></TR></TABLE>>, fillcolor="#e2e2e2"];
  cnz [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Nasal zero (FN)</B>  <FONT POINT-SIZE="9" COLOR="#666666">[136]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">antiresonator on the pole's output</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w32 = FN (p16)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w33 fixed: bandwidth 103 Hz</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">no saturation</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  c1 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>R1 (F1)</B>  <FONT POINT-SIZE="9" COLOR="#666666">[11C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w14 / w15 = F1, B1 (p9, p13)</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  xw36 [label=<× 2·w36<BR/><FONT POINT-SIZE="8">R1 gain (×16)</FONT>>, shape=box, style="rounded,filled", fontsize=10, fillcolor="#fcd9b0", margin="0.06,0.03"];
  }
  subgraph cluster_par { label=<<B>Parallel branch</B> (noise only; all amplitudes 0 when AF = 0)>; style=rounded; color="#b5652f"; fontcolor="#b5652f";
  vmod [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Voicing modulation</B>  <FONT POINT-SIZE="9" COLOR="#666666">[09F]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">noise ÷ 2 in the second half</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">of each pitch period</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">(RAM[3E] ^ RAM[3F] &lt; 0)</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  phf [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>HF resonator</B>  <FONT POINT-SIZE="9" COLOR="#666666">[13C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">w2 / w3, fixed</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">4929 Hz / 799 Hz</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">amp w18 ← A6 (p7)</FONT></TD></TR></TABLE>>, fillcolor="#e2e2e2"];
  p5 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>F5</B>  <FONT POINT-SIZE="9" COLOR="#666666">[13C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">coefficients of R5</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">amp w20 ← A5 (p6)</FONT></TD></TR></TABLE>>, fillcolor="#cdeccb"];
  p4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>F4</B>  <FONT POINT-SIZE="9" COLOR="#666666">[13C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">coefficients of R4</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">amp w22 ← A4 (p5)</FONT></TD></TR></TABLE>>, fillcolor="#cfe3fa"];
  p3 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>F3</B>  <FONT POINT-SIZE="9" COLOR="#666666">[13C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">coefficients of R3</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">amp w24 ← A3 (p4)</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  p2 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>F2</B>  <FONT POINT-SIZE="9" COLOR="#666666">[13C]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">coefficients of R2</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">amp w26 ← A2 (p3)</FONT></TD></TR></TABLE>>, fillcolor="#fcd9b0"];
  pab [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Bypass</B></TD></TR><TR><TD><FONT POINT-SIZE="9">amp w28 ← AB (p8)</FONT></TD></TR></TABLE>>, fillcolor="#cfe3fa"];
  spar [label="Σ", shape=circle, fixedsize=true, width=0.42, fontsize=15, fillcolor="#ffffff"];
  xpar [label=<× 0x184D<BR/><FONT POINT-SIZE="8">setup word 0 (×0.190)</FONT>>, shape=box, style="rounded,filled", fontsize=10, fillcolor="#e2e2e2", margin="0.06,0.03"];
  pdiff [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>First difference</B></TD></TR></TABLE>>, fillcolor="#ffffff"];
  }
  subgraph cluster_out { label=<<B>Output</B>>; style=rounded; color="#888888";
  sout [label="Σ", shape=circle, fixedsize=true, width=0.42, fontsize=15, fillcolor="#ffffff"];
  deemph [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>One-pole filter</B>  <FONT POINT-SIZE="9" COLOR="#666666">[0B1]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">y = x − 0.23·y[n−1]  (0x1D71)</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  bias [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Bias and clip</B></TD></TR><TR><TD><FONT POINT-SIZE="9">+ w0 offset (one sample)</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">+ 0x1001, clip to 0-0x1FFF</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">silence (w0 bit 7): 0x0FE0</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  fifo [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Output FIFO</B></TD></TR><TR><TD><FONT POINT-SIZE="9">RAM[00-0D], 14 slots</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  sio [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>Sample interrupt</B>  <FONT POINT-SIZE="9" COLOR="#666666">[100]</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">SOL: RAM[22] bit-reversed</FONT></TD></TR><TR><TD><FONT POINT-SIZE="9">onto the serial output</FONT></TD></TR></TABLE>>, fillcolor="#ffffff"];
  dac [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B>12-bit DAC</B></TD></TR><TR><TD><FONT POINT-SIZE="9">10 kHz</FONT></TD></TR></TABLE>>, fillcolor="#e2e2e2"];
  }
  key [shape=plaintext, style="", fontsize=9, label=<<TABLE BORDER="1" COLOR="#aaaaaa" CELLBORDER="0" CELLSPACING="3" CELLPADDING="2" STYLE="rounded"><TR><TD COLSPAN="2"><B>When a value changes</B></TD></TR><TR><TD BGCOLOR="#cfe3fa" BORDER="1" COLOR="#555555" WIDTH="22"> </TD><TD ALIGN="LEFT">every frame (10 ms)</TD></TR><TR><TD BGCOLOR="#fcd9b0" BORDER="1" COLOR="#555555" WIDTH="22"> </TD><TD ALIGN="LEFT">pitch-synchronous: latched at each period start</TD></TR><TR><TD BGCOLOR="#cdeccb" BORDER="1" COLOR="#555555" WIDTH="22"> </TD><TD ALIGN="LEFT">per voice (ESC[nV), sent in every frame</TD></TR><TR><TD BGCOLOR="#e2e2e2" BORDER="1" COLOR="#555555" WIDTH="22"> </TD><TD ALIGN="LEFT">fixed: frame template / setup words</TD></TR><TR><TD>——</TD><TD ALIGN="LEFT">signal</TD></TR><TR><TD><FONT COLOR="#9a3fb8">- - -</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#9a3fb8">control</FONT></TD></TR></TABLE>>];
  pulse -> gdiff;
  gdiff -> xw17;
  xw17 -> ssrc [label=<voice>];
  noise -> xah;
  xah -> ssrc [label=<aspiration>];
  ssrc -> glot;
  glot -> c5 [label=<× w19<BR/><FONT POINT-SIZE="8">(0x2000)</FONT>>];
  c5 -> c4 [label=<× w21>];
  c4 -> c3 [label=<× w23>];
  c3 -> c2 [label=<× w25>];
  c2 -> cnp [label=<× w27>];
  cnp -> cnz [label=<+ old y2>];
  cnz -> c1 [label=<× w29>];
  c1 -> xw36;
  xw36 -> sout [label=<cascade>];
  noise -> vmod [label=<noise>];
  vmod -> phf;
  phf -> spar [label=<+>];
  vmod -> p5;
  p5 -> spar [label=<−>];
  vmod -> p4;
  p4 -> spar [label=<+>];
  vmod -> p3;
  p3 -> spar [label=<−>];
  vmod -> p2;
  p2 -> spar [label=<+>];
  vmod -> pab;
  pab -> spar [label=<+>];
  spar -> xpar;
  xpar -> pdiff;
  pdiff -> sout [label=<parallel>];
  sout -> deemph;
  deemph -> bias;
  bias -> fifo;
  fifo -> sio;
  sio -> dac;
  fetch -> pitch [label=<w30, w31>, color="#9a3fb8", fontcolor="#9a3fb8", style=dashed, arrowhead=vee];
  fetch -> pulse [label=<w0, w1, w34, w35>, color="#9a3fb8", fontcolor="#9a3fb8", style=dashed, arrowhead=vee];
  pitch -> pulse [label=<period start: phase 0,<BR/>next AV, step, type>, color="#9a3fb8", fontcolor="#9a3fb8", style=dashed, arrowhead=vee];
  pitch -> vmod [label=<half period>, color="#9a3fb8", fontcolor="#9a3fb8", style=dashed, arrowhead=vee];
  { rank=same; glot; vmod; }
  { rank=same; sout; deemph; bias; fifo; sio; dac; }
  { rank=same; fetch; pitch; key; }
  { rank=same; pulse; noise; }
}
